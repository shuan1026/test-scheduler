# ── 資料庫（AIBorn「資料庫」分頁 →「帶入第二步環境變數」會自動帶入以下 5 個）──
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=cron_playground
DATABASE_USER=cron
DATABASE_PASSWORD=change-me

# 是否以 SSL 連線（不驗證憑證）。AIBorn 上保持預設 true；本機 MySQL 不支援 SSL 時可設 false
DATABASE_SSL=true

# ── 實驗用 ──
# 測「只更新環境變數」：改值後重新部署，下一次心跳排程的 Log 應印出新值
PLAYGROUND_MARKER=v1

# 注意：PORT 由 Cloud Run 注入，不要寫在這裡（AIBorn 也會自動移除）
